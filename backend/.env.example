# Django
SECRET_KEY=cambia-questa-chiave-segreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional one-time bootstrap: both username and password are required. No
# account is created when absent or PROPERTY_ARCHIVE_PRIVATE=True. Existing
# accounts are never changed; remove these variables after initial creation.
# Before private archive cutover, rotate/disable any previously deployed demo
# admin credentials manually. This release does not rotate existing accounts.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/studiotara

# Media (immagini immobili — Railway Volume)
MEDIA_ROOT=/app/media

# Feed GestionaleImmobiliare.it
GESTIONALE_FEED_URL=https://pannello.gestionaleimmobiliare.it/export_xml_annunci.html?agenzia_id=7519&filter=sito&public_key=2ca34eb78b550233&latlng=1&abstract=1&finiture=1&agente=1&etichette=1

# Email (configurare con il provider SMTP dell'agenzia quando disponibile)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@studiotara.it
AGENCY_EMAIL=info@studiotara.it

# CORS — origini Next.js consentite
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set both at property cutover; also disable external cron jobs.
PROPERTY_SYNC_ENABLED=True
PROPERTY_ADMIN_READ_ONLY=False
# Enable only after the website reads reviewed dashboard listings. Legacy
# property APIs and /media/properties/ then require a logged-in staff user with
# properties.view_property. Blog/review media stays public; view increments stop.
# Ingress/CDN must route property media through Django (no public static alias)
# and purge previously cached property APIs/media at cutover.
PROPERTY_ARCHIVE_PRIVATE=False
